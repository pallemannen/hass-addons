worker_processes 1;
events { worker_connections 1024; }

http {
    server {
        listen 80;
        listen 8080;
        listen 8123;
        server_name _;
        return 301 ${SCHEME}://${TARGET_HOST}:${TARGET_PORT}$request_uri;
    }

    server {
        listen 443 ssl;
        listen 8443 ssl;
        server_name _;
        ssl_certificate     /ssl/fullchain.pem;
        ssl_certificate_key /ssl/privkey.pem;
        return 301 ${SCHEME}://${TARGET_HOST}:${TARGET_PORT}$request_uri;
    }
}
